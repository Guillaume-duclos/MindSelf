{
  "expo": {
    "name": "MindSelf",
    "slug": "MindSelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "",
    "scheme": "mindself",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "",
      "bundleIdentifier": "com.anonymous.MindSelf"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "",
        "backgroundImage": "",
        "monochromeImage": ""
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MindSelf"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./src/assets/fonts/NotoSerif-Variable.ttf",
              "./src/assets/fonts/NotoSerif-Italic-Variable.ttf",
              "./src/assets/fonts/PublicSans-Variable.ttf",
              "./src/assets/fonts/PublicSans-Italic-Variable.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Noto Serif",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/NotoSerif-Variable.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./src/assets/fonts/NotoSerif-Italic-Variable.ttf",
                    "weight": 400,
                    "style": "italic"
                  }
                ]
              },
              {
                "fontFamily": "Public Sans",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/PublicSans-Variable.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./src/assets/fonts/PublicSans-Italic-Variable.ttf",
                    "weight": 400,
                    "style": "italic"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "L'application a besoin d'accéder à tes photos pour enregistrer l'image de l'affirmation."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
